# 复制为 .env 并填写（.env 永不提交）
POSTGRES_PASSWORD=$(openssl rand -hex 24)
ADMIN_API_KEYS=$(openssl rand -hex 32)
MANAGE_TOKEN_SECRET=$(openssl rand -hex 32)

# LLM（DeepSeek）
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding（DeepSeek 无 embedding 端点，用硅基流动或本地 BGE）
EMBED_PROVIDER=siliconflow        # siliconflow | local | jina
EMBED_API_KEY=sk-xxxxxxxx
EMBED_MODEL=BAAI/bge-m3           # 1024 维，与建表 vector(1024) 匹配
EMBED_DIM=1024

# 限流与预算护栏
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
DAILY_LLM_BUDGET_YUAN=5

# 对外基础 URL（拼分享链接）
PUBLIC_BASE_URL=https://share.cogseed.dev
