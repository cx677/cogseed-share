# 复制为 .env 并填写（.env 永不提交）
POSTGRES_PASSWORD=$(openssl rand -hex 24)
ADMIN_API_KEYS=$(openssl rand -hex 32)
MANAGE_TOKEN_SECRET=$(openssl rand -hex 32)

# LLM（DeepSeek）
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Embedding（DeepSeek 无 embedding 端点；默认本地 fastembed 零成本，可选硅基流动）
EMBED_PROVIDER=siliconflow   # siliconflow(推荐) | local(仅x64/mac,零成本) | jina
EMBED_API_KEY=sk-xxxxxxxx
EMBED_MODEL=fast-bge-small-zh-v1.5  # 512 维，与建表 vector(512) 匹配（本地）
EMBED_DIM=512

# 限流与预算护栏
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
DAILY_LLM_BUDGET_YUAN=5

# 对外基础 URL（拼分享链接）
PUBLIC_BASE_URL=https://share.cogseed.dev
